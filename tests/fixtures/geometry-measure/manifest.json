    { "id": "control-height-mutation", "file": "all.green.html", "mutationCss": ".ctl-btn { height: 34px !important; }", "fail": ["controlHeight"], "values": { "controlHeight": 2 }, "reasons": { "controlHeight": ["mismatch"] } },

    { "id": "overlap-green", "file": "overlap.green.html", "pass": ["overlap"], "values": { "overlap": 0 } },
    { "id": "overlap-red", "file": "overlap.red.html", "fail": ["overlap"], "values": { "overlap": 1 } },
    { "id": "overlap-mutation", "file": "all.green.html", "mutationCss": ".form-grid > .lab:first-child { width: 300px !important; }", "fail": ["overlap"], "values": { "overlap": 1 } },

    { "id": "shell-frame-green", "file": "shellFrame.green.html", "pass": ["shellFrame"], "values": { "shellFrame": 0 } },
    { "id": "shell-frame-red", "file": "shellFrame.red.html", "fail": ["shellFrame"], "values": { "shellFrame": 16 }, "reasons": { "shellFrame": ["paper_inset", "top_bar_height", "paper_missing", "top_bar_missing"] } },
    { "id": "shell-frame-paper-flush-mutation", "file": "all.green.html", "mutationCss": ".paper { top: 0 !important; right: 0 !important; bottom: 0 !important; }", "fail": ["shellFrame"], "values": { "shellFrame": 12 }, "reasons": { "shellFrame": ["paper_inset"] } },
    { "id": "shell-frame-top-bar-68-mutation", "file": "all.green.html", "mutationCss": ".paper > .tcrn-top-bar { height: 68px !important; }", "fail": ["shellFrame"], "values": { "shellFrame": 16 }, "reasons": { "shellFrame": ["top_bar_height"] } }
  ]
