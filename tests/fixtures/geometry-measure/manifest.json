    { "id": "clip-mutation", "file": "all.green.html", "mutationCss": ".inner { width: 280px !important; }", "fail": ["clip"], "values": { "clip": 1 } },

    { "id": "single-line-green", "file": "singleLine.green.html", "pass": ["singleLine"], "values": { "singleLine": 1 } },
    { "id": "single-line-red", "file": "singleLine.red.html", "fail": ["singleLine"], "values": { "singleLine": { "min": 2 } } },
