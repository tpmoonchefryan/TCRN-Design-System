    { "id": "shadow-blur-red", "file": "shadowBlur.red.html", "fail": ["shadowBlur"], "values": { "shadowBlur": 4 } },
    { "id": "shadow-blur-pseudo-mutation", "file": "shadowBlur.green.html", "mutationCss": ".card::after { content: \"\"; display: block; height: 4px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2); }", "fail": ["shadowBlur"], "values": { "shadowBlur": 8 } },
    { "id": "shadow-blur-mutation", "file": "all.green.html", "mutationCss": ".card { box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2) !important; }", "fail": ["shadowBlur"], "values": { "shadowBlur": 4 } },

    { "id": "rail-green", "file": "rail.green.html", "pass": ["rail"], "values": { "rail": 0 } },
    { "id": "rail-red", "file": "rail.red.html", "fail": ["rail"], "values": { "rail": 4 } },
    { "id": "rail-mutation", "file": "all.green.html", "mutationCss": ".rail-item { padding-left: 20px !important; }", "fail": ["rail"], "values": { "rail": 4 } },

    { "id": "row-align-green", "file": "rowAlign.green.html", "pass": ["rowAlign"], "values": { "rowAlign": 0 } },
    { "id": "row-align-red", "file": "rowAlign.red.html", "fail": ["rowAlign"], "values": { "rowAlign": 8 } },
    { "id": "row-align-mutation", "file": "all.green.html", "mutationCss": ".tcrn-table tr[aria-selected=\"true\"] > td:first-child { padding-left: 16px !important; }", "fail": ["rowAlign"], "values": { "rowAlign": 8 } },

    { "id": "mark-green", "file": "mark.green.html", "pass": ["mark"], "values": { "mark": 0 } },
    { "id": "mark-red", "file": "mark.red.html", "fail": ["mark"], "values": { "mark": 2 } },
    { "id": "mark-mutation", "file": "all.green.html", "mutationCss": "mark { padding: 2px !important; }", "fail": ["mark"], "values": { "mark": 2 } },

    { "id": "contrast-green", "file": "contrast.green.html", "pass": ["contrast"], "values": { "contrast": { "min": 0, "max": 0.05 } } },
    { "id": "contrast-red", "file": "contrast.red.html", "fail": ["contrast"], "values": { "contrast": { "min": 13 } }, "reasons": { "contrast": ["diff"] } },
    { "id": "contrast-minimum-red", "file": "contrast.minimum.red.html", "fail": ["contrast"], "values": { "contrast": 0 }, "reasons": { "contrast": ["below_minimum"] } },
    { "id": "contrast-missing-expect-red", "file": "contrast.missing-expect.red.html", "fail": ["contrast"], "reasons": { "contrast": ["missing_expect"] } },
    { "id": "contrast-mutation", "file": "all.green.html", "mutationCss": "[data-cell=\"ink\"] { color: #6b6b6b !important; }", "fail": ["contrast"], "values": { "contrast": { "min": 13 } }, "reasons": { "contrast": ["diff"] } },

    { "id": "control-height-green", "file": "controlHeight.green.html", "pass": ["controlHeight"], "values": { "controlHeight": 0 } },
    { "id": "control-height-red", "file": "controlHeight.red.html", "fail": ["controlHeight"], "values": { "controlHeight": 2 }, "reasons": { "controlHeight": ["mismatch"] } },
