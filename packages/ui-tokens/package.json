{
  "name": "@tcrn/ui-tokens",
  "version": "4.1.0",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "sideEffects": [
    "src/tokens.css",
    "src/halloween.css",
    "fonts/fonts.css"
  ],
  "files": [
    "dist",
    "src/tokens.css",
    "src/halloween.css",
    "fonts",
    "licenses",
    "FONT-LICENSES.md",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/test/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./halloween.css": "./src/halloween.css",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/index.test.js",
    "prepack": "node ../../scripts/prepare-package.mjs --package ui-tokens"
  }
}
