<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>产品标</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&amp;family=Source+Serif+4:opsz,wght@8..60,300;8..60,400;8..60,500&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Noto+Sans+SC:wght@400;500;600&amp;family=Noto+Serif+SC:wght@300;400&amp;display=swap">
<style>

body{margin:0}
*{box-sizing:border-box}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.board{position:relative;width:2640px;padding:48px;display:flex;flex-direction:column;gap:40px;background:#efeeea;color:#16150f;font-family:"Hanken Grotesk","Noto Sans SC",system-ui,sans-serif;font-size:13px;line-height:1.5;font-variant-numeric:tabular-nums;overflow:hidden}
.bh{display:grid;grid-template-columns:1560px minmax(0,1fr);column-gap:48px;align-items:end;padding-bottom:22px;border-bottom:1px solid rgba(22,21,15,.16)}
.bh .k{margin:0;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#6b675d;font-weight:500}
.bh h1{margin:6px 0 0;font-family:"Source Serif 4","Noto Serif SC",Georgia,serif;font-size:44px;line-height:1.05;font-weight:400;letter-spacing:-.01em}
.bh h1 em{font-style:normal;color:#8e2d24}
.bh p{margin:10px 0 0;font-size:14px;color:#4f4c43;line-height:1.6;max-width:1400px}
.bh .meta{font-size:12px;color:#6b675d;line-height:1.6;text-align:right}
.bh .meta b{display:block;color:#16150f;font-weight:500}
.sec{display:flex;flex-direction:column;gap:18px}
.sec>h3{margin:0;font-size:11px;line-height:16px;letter-spacing:.14em;text-transform:uppercase;color:#6b675d;font-weight:500;padding-bottom:8px;border-bottom:1px solid rgba(22,21,15,.16);display:flex;align-items:center;gap:14px}
.sec>h3 b{font-family:"IBM Plex Mono",ui-monospace,monospace;color:#16150f;font-weight:500}
.sec>h3 span{letter-spacing:0;text-transform:none;font-weight:400;color:#4f4c43;font-size:12.5px;line-height:16px}
.two{display:grid;grid-template-columns:1248px 1248px;column-gap:48px;align-items:start}
.pane{position:relative;padding:24px 28px 28px;border-radius:14px;background:var(--bg);color:var(--ink);box-shadow:var(--s1);display:flex;flex-direction:column;gap:22px;font-family:var(--sans);overflow:hidden}
.pane>.grain{position:absolute;left:0;top:0;width:100%;height:100%;opacity:var(--grain);mix-blend-mode:var(--blend);pointer-events:none;z-index:0}
.pane>.ptag{position:absolute;top:14px;right:18px;z-index:2;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3)}
.pane>.blk{position:relative;z-index:1;display:flex;flex-direction:column;gap:14px}
.blk>h6{margin:0;font-size:10.5px;line-height:16px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);font-weight:500;display:flex;align-items:center;gap:10px}
.blk>h6 span{letter-spacing:0;text-transform:none;font-weight:400;color:var(--ink-2);font-size:12px;line-height:16px}
.row{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.row.top{align-items:flex-start}
.cell{display:flex;flex-direction:column;align-items:flex-start;gap:7px;min-width:0}
.cell>small{font-size:10.5px;color:var(--ink-3);font-family:var(--mono);white-space:nowrap}
.paper{padding:16px 18px;border-radius:var(--r-panel);background:var(--panel);box-shadow:var(--s1);--surface:var(--panel);display:flex;flex-direction:column;gap:14px}
.mx{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px;background:#ffffff;border-radius:12px;box-shadow:0 0 0 1px rgba(22,21,15,.08);overflow:hidden}
.mx th{text-align:left;height:34px;padding:0 10px;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#6b675d;font-weight:500;border-bottom:1px solid #16150f;background:#f6f5f1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mx td{height:34px;padding:0 10px;border-bottom:1px solid rgba(22,21,15,.09);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#4f4c43;vertical-align:middle}
.mx tr:last-child td{border-bottom:0}
.mx td.c{color:#16150f;font-weight:600}
.mx td.m{font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:11px;color:#16150f}
.mx td.n{font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:11.5px;color:#16150f;text-align:right}
.mx td.n.lo{color:#a8321f}
.mx td.n.ex{color:#6b675d}
.mx tr.grp td{background:#f6f5f1;color:#16150f;font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;height:28px}
.mx .sw{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:6px;box-shadow:inset 0 0 0 1px rgba(22,21,15,.14)}
.mx td.r{text-align:right}
.box{background:#ffffff;border-radius:12px;box-shadow:0 0 0 1px rgba(22,21,15,.08);padding:16px 18px;display:flex;flex-direction:column;gap:8px;min-width:0}
.box h4{margin:0;font-size:13px;font-weight:600}
.box h4 small{font-weight:400;color:#6b675d;margin-left:8px;font-size:12px}
.box p,.box li{margin:0;font-size:12.5px;color:#4f4c43;line-height:1.55}
.box ol,.box ul{margin:0;padding-left:18px}
.box li{margin:3px 0}
.box b{color:#16150f;font-weight:600}
.box code{font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:11.5px;color:#16150f}
.box .lead{font-size:13.5px;color:#16150f}
.cols3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:start}
.cols2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:start}
.cols4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;align-items:start}
.ic{display:inline-block;flex:0 0 auto;vertical-align:middle}
.spin{animation:spin var(--t-loop) linear infinite;transform-origin:50% 50%}
@keyframes spin{to{transform:rotate(360deg)}}

.gp{--bg:#efeeea;--bg-2:#e7e5df;--panel:#ffffff;--panel-2:#f8f7f3;--line:rgba(22,21,15,.09);--line-2:rgba(22,21,15,.16);--line-3:rgba(22,21,15,.30);--line-ctl:rgba(22,21,15,.47);--rule:#16150f;--ink:#16150f;--ink-2:#4f4c43;--ink-3:#6b675d;--acc:#0b6b65;--acc-2:#0a5f5a;--acc-3:#084f4a;--acc-bg:rgba(11,107,101,.08);--acc-ul:rgba(11,107,101,.7);--on-acc:#ffffff;--red:#8e2d24;--red-bg:rgba(142,45,36,.06);--red-bg-2:rgba(142,45,36,.11);--ok:#2f6b3a;--warn:#8a5a08;--bad:#a8321f;--bad-bg:rgba(168,50,31,.08);--wash:rgba(22,21,15,.06);--hover:rgba(22,21,15,.035);--dis:rgba(22,21,15,.05);--s1:0 1px 1px rgba(22,21,15,.04),0 0 0 1px rgba(22,21,15,.07);--s2:0 1px 2px rgba(22,21,15,.05),0 2px 3px rgba(22,21,15,.04),0 0 0 1px rgba(22,21,15,.08);--s3:0 2px 3px rgba(22,21,15,.06),0 3px 3px rgba(22,21,15,.06),0 0 0 1px rgba(22,21,15,.10);--glass:rgba(255,255,255,.78);--edge:inset 0 0 0 1px rgba(255,255,255,.8);--grain:.035;--blend:multiply;--av-bg:#e7e5df;--av-ink:#16150f;--knob:#ffffff;--chrome:rgba(239,238,234,.82);--surface:var(--bg);--focus:0 0 0 2px var(--surface),0 0 0 4px var(--acc);--serif:"Source Serif 4","Noto Serif SC",Georgia,serif;--sans:"Hanken Grotesk","Noto Sans SC",system-ui,sans-serif;--mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;--r-ctl:8px;--r-sm:6px;--r-panel:12px;--r-check:4px;--r-stamp:3px;--h-sm:28px;--h-md:32px;--h-lg:40px;--pad-sm:10px;--pad-md:12px;--pad-lg:16px;--fs-sm:12px;--fs-md:13px;--fs-lg:14px;--ico-sm:14px;--ico-md:16px;--ico-lg:20px;--ease:cubic-bezier(.22,1,.36,1);--t-fill:120ms;--t-press:80ms;--t-move:240ms;--t-loop:900ms}
.gp.night{--bg:#121210;--bg-2:#0d0d0b;--panel:#191916;--panel-2:#1f1f1b;--line:rgba(255,255,255,.07);--line-2:rgba(255,255,255,.13);--line-3:rgba(255,255,255,.26);--line-ctl:rgba(255,255,255,.36);--rule:#ebe8df;--ink:#ebe8df;--ink-2:#a9a69c;--ink-3:#85827a;--acc:#3fc7b7;--acc-2:#5ad3c5;--acc-3:#34b3a4;--acc-bg:rgba(63,199,183,.10);--acc-ul:rgba(63,199,183,.7);--on-acc:#07211e;--red:#d98d82;--red-bg:rgba(217,141,130,.08);--red-bg-2:rgba(217,141,130,.14);--ok:#6fcf97;--warn:#d9ab52;--bad:#e5897b;--bad-bg:rgba(229,137,123,.10);--wash:rgba(235,232,223,.07);--hover:rgba(235,232,223,.04);--dis:rgba(235,232,223,.05);--s1:0 1px 1px rgba(0,0,0,.3),0 0 0 1px rgba(255,255,255,.06);--s2:0 1px 2px rgba(0,0,0,.35),0 2px 3px rgba(0,0,0,.3),0 0 0 1px rgba(255,255,255,.07);--s3:0 2px 3px rgba(0,0,0,.4),0 3px 3px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.09);--glass:rgba(25,25,22,.74);--edge:inset 0 1px 0 rgba(255,255,255,.06);--grain:.06;--blend:screen;--av-bg:#2a2a26;--av-ink:#ebe8df;--knob:#ffffff;--chrome:rgba(18,18,16,.82)}

.scr{position:relative;width:1240px;height:640px;overflow:hidden;background:var(--bg);color:var(--ink);border-radius:14px;box-shadow:var(--s1);font-size:13px;line-height:1.5;font-family:var(--sans)}
.scr>.grain{position:absolute;left:0;top:0;width:100%;height:100%;opacity:var(--grain);mix-blend-mode:var(--blend);pointer-events:none;z-index:0}
.scr>.lay{position:relative;z-index:1;width:100%;height:100%;display:grid;grid-template-columns:220px minmax(0,1fr)}
.rail{display:flex;flex-direction:column;gap:2px;padding:16px 12px 14px;min-height:0}
.brand{display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:10px;align-items:center;padding:2px 4px 14px;min-width:0}
.brand .mk{width:22px;height:22px;display:block;flex:0 0 auto}
.brand b{display:block;font-size:12.5px;font-weight:600;line-height:1.2;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand small{display:block;font-size:10.5px;color:var(--ink-3);letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nv{display:grid;grid-template-columns:22px minmax(0,1fr) auto;column-gap:10px;align-items:center;height:32px;padding:0 6px 0 4px;border-radius:8px;color:var(--ink-2);text-decoration:none;font-size:12.5px;font-weight:500;white-space:nowrap;min-width:0}
.nv>span.t{overflow:hidden;text-overflow:ellipsis}
.nv .ic{width:22px;height:22px;padding:3px;color:var(--ink-3)}
.nv .cnt{justify-self:end;font-family:var(--mono);font-size:10.5px;color:var(--ink-3)}
.nv:hover{background:var(--hover);color:var(--ink)}
.nv.on{background:var(--panel);color:var(--ink);box-shadow:var(--s1)}
.nv.on .ic{color:var(--ink)}
.rail h6{margin:12px 0 4px 4px;padding:0;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);font-weight:500}
.rail .user{margin-top:auto;padding:12px 4px 2px;border-top:1px solid var(--line);display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:10px;align-items:center;min-width:0}
.rail .user .av{width:22px;height:22px;font-size:10px}
.rail .user b{display:block;font-size:12px;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rail .user small{display:block;font-size:10.5px;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.av{width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:500;background:var(--av-bg);color:var(--av-ink);flex:0 0 auto;box-shadow:inset 0 0 0 1px var(--line)}
.sheet{margin:12px 12px 12px 0;background:var(--panel);border-radius:14px;box-shadow:var(--s1);display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;--surface:var(--panel)}
.topbar{display:flex;align-items:center;gap:12px;height:52px;padding:0 28px;border-bottom:1px solid var(--line);flex:0 0 auto;min-width:0}
.crumbs{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ink-3);white-space:nowrap;flex:0 0 auto}
.crumbs a{color:var(--ink-2);text-decoration:none}
.crumbs b{color:var(--ink);font-weight:600}
.crumbs .ic{width:11px;height:11px}
.sp{flex:1 1 auto;min-width:0}
.content{padding:18px 28px 14px;flex:1;min-height:0;display:flex;flex-direction:column;gap:12px;overflow:hidden}
.ph{display:flex;align-items:flex-end;gap:14px;padding-bottom:12px;border-bottom:1px solid var(--line-2);min-width:0}
.ph h2{margin:0;font-family:var(--serif);font-size:26px;line-height:1.1;font-weight:400;letter-spacing:-.005em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.ph .sub{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-weight:500;white-space:nowrap;padding-bottom:4px;flex:0 0 auto}
.ph .act{margin-left:auto;display:flex;align-items:center;gap:8px;flex:0 0 auto}
.tabs{display:flex;gap:18px;border-bottom:1px solid var(--line)}
.tabs a{position:relative;padding:4px 0 9px;font-size:12.5px;color:var(--ink-3);text-decoration:none;font-weight:500;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.tabs a.on{color:var(--ink);font-weight:600}
.tabs a.on:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:1px;background:var(--rule)}
.tabs .n{font-family:var(--mono);font-size:10.5px;color:var(--ink-3)}
.tbl{width:calc(100% + 16px);margin:0 -8px;border-collapse:collapse;table-layout:fixed;font-size:12.5px}
.tbl th{height:30px;text-align:left;padding:0 10px;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-weight:500;border-bottom:1px solid var(--line-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tbl th:first-child,.tbl td:first-child{padding-left:8px}
.tbl th:last-child,.tbl td:last-child{padding-right:8px}
.tbl th.r,.tbl td.r{text-align:right}
.tbl td{height:38px;padding:0 10px;border-bottom:1px solid var(--line);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;vertical-align:middle;color:var(--ink-2)}
.tbl tr.sel td{background:var(--wash);color:var(--ink)}
.tbl tr.sel td:first-child{border-radius:6px 0 0 6px}
.tbl tr.sel td:last-child{border-radius:0 6px 6px 0}
.st{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-2);white-space:nowrap}
.st i{width:6px;height:6px;border-radius:50%;background:currentColor;flex:0 0 auto}
.st.ok{color:var(--ok)}.st.warn{color:var(--warn)}.st.bad{color:var(--bad)}
.chip{display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:4px;font-size:11px;font-weight:500;color:var(--ink-2);box-shadow:inset 0 0 0 1px var(--line-2);white-space:nowrap}
.mono{font-family:var(--mono);font-size:11.5px}
.tfoot{display:flex;align-items:center;gap:8px;padding:8px 0 0;font-size:11px;letter-spacing:.06em;color:var(--ink-3);text-transform:uppercase;font-weight:500;white-space:nowrap}
.stamp{display:inline-flex;align-items:center;gap:8px;padding:5px 10px;border:1px solid var(--red);border-radius:var(--r-stamp);color:var(--red);font-family:var(--serif);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;font-weight:500;line-height:1.2;white-space:nowrap}
.stamp i{width:5px;height:5px;border-radius:50%;background:currentColor}


.hero{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.hb{display:flex;flex-direction:column;gap:12px;min-width:0;color:var(--ink)}
.hb .st{display:flex;align-items:center;justify-content:center;height:300px;border-radius:14px;background:var(--panel);box-shadow:var(--s1)}
.hb h5{margin:0;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hb h5 small{font-weight:400;color:var(--ink-3);margin-left:6px}
.hb p{margin:0;font-size:12.5px;line-height:1.55;color:var(--ink-2)}
.chips{display:flex;gap:8px 10px;align-items:center;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10.5px;color:var(--ink-3);white-space:nowrap}
.chip i{width:14px;height:14px;border-radius:4px;display:inline-block;box-shadow:inset 0 0 0 1px rgba(22,21,15,.1)}
.ladder{display:grid;grid-template-columns:150px repeat(6,minmax(0,1fr));align-items:end;column-gap:12px;row-gap:16px}
.ladder>b{font-size:12px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;align-self:center}
.ladder .c{display:flex;flex-direction:column;align-items:center;gap:6px;color:var(--ink)}
.ladder .hd{font-family:var(--mono);font-size:10.5px;color:var(--ink-3);text-align:center;white-space:nowrap}
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.tl{display:flex;flex-direction:column;gap:8px;align-items:flex-start}
.tl .r{display:flex;align-items:flex-end;gap:12px}
.tl small{font-family:var(--mono);font-size:10.5px;color:var(--ink-3);white-space:nowrap}
.mono4{display:flex;gap:28px;align-items:center;color:var(--ink)}
.lock{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 28px}
.lk{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:14px;align-items:center;min-width:0;color:var(--ink)}
.lk .w{display:grid;gap:2px;min-width:0}
.lk .w b{font-size:16px;line-height:20px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.005em}
.lk .w b.serif{font-family:var(--serif);font-weight:400;font-size:18px;letter-spacing:.03em}
.lk .w b em,.rail b em{font-style:normal}
.lk .w small{font-size:11.5px;line-height:16px;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lk .w small.by{font-size:10px;letter-spacing:.14em;text-transform:uppercase}
.rail{display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:10px;align-items:center;padding:6px 4px;width:210px;color:var(--ink)}
.rail b{display:block;font-size:12.5px;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rail b.serif{font-family:var(--serif);font-weight:400;font-size:13.5px;letter-spacing:.02em}
.rail small{display:block;font-size:10.5px;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.src{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.src pre{margin:0;padding:14px 16px;border-radius:12px;background:#fff;box-shadow:0 0 0 1px rgba(22,21,15,.08);font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:11px;line-height:1.55;color:#16150f;white-space:pre-wrap;word-break:break-all}
.src pre b{display:block;font-family:"Hanken Grotesk","Noto Sans SC",sans-serif;font-size:12.5px;margin-bottom:6px}
.src pre span{color:#6b675d}
.grid48{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.g48{display:flex;flex-direction:column;gap:8px;align-items:center}
.g48 small{font-family:var(--mono);font-size:10.5px;color:var(--ink-3);white-space:nowrap}
.lk .w b,.rail b{overflow:visible;text-overflow:clip}

</style>
</helmet>
<div class="board" style="width: 2640px; height: 3372px">

<header class="bh">
<div>
<p class="k">Visual standard · Product marks · approved 2026-10-11</p>
<h1>四枚产品标：实心几何，两色平涂<em>，每枚一个形</em></h1>
<p>Owner 2026-10-11 通过本稿（两处修订：TCRN 产品后缀用产品色；Mana Orchestrate 的名称与标语不提宿主）。实心的几何形，每枚两种平涂色，颜色从 TCRN 母标现有的蓝、藏青、黄绿与四色里取，没有渐变、描边与投影。TCRN TMS 是双臂高举的艺人，Einzbern 是接住一点光的盃，Mana Orchestrate 是两结点之间的一道流，TCRN Design System 是一张四色版面。一个形从 128 到 16 不换切法；侧栏与应用图标用淡底贴片，favicon 用深底贴片，禁色场合用单色版。</p>
</div>
<div class="meta"><b>48 格 · 圆角 4 · 视觉圆 r 22</b>实心，无描边、无渐变、无投影<b>每枚两色：深 + 亮</b>蓝 · 藏青 · 绿 · 四色，均出自母标<b>一个形走完 128 到 16</b>贴片两种：淡底、深底</div>
</header>

<div class="sec"><h3><b>A–E</b>四枚标 · 浅色与夜间 <span>大图、尺寸阶梯、贴片、单色版、锁定块</span></h3>
<div class="two"><section class="pane gp" aria-label="浅色">
<svg class="grain" aria-hidden="true"><filter id="lg2-l"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#lg2-l)"/></svg>
<span class="ptag">light · 画布 #efeeea · 纸 #ffffff</span>
<div class="blk"><h6>A · 四枚标 <span>实心几何，每枚两种平涂色；48 格，圆角 4；没有描边、渐变、投影</span></h6><div class="hero"><div class="hb"><div class="st"><svg viewBox="0 0 48 48" width="200" height="200" aria-hidden="true" data-logo="tms" data-mode="color" data-size="200"><path d="M11 23L24 39" stroke="#2c63c8" stroke-width="9" stroke-linecap="round" fill="none"/><path d="M37 23L24 39" stroke="#7aa0f5" stroke-width="9" stroke-linecap="round" fill="none"/><circle cx="24" cy="12.5" r="8" fill="#2c63c8"/></svg></div><h5>TCRN TMS<small>艺人管理系统</small></h5><div class="chips"><span class="chip"><i style="background:#2c63c8"></i>#2c63c8</span><span class="chip"><i style="background:#7aa0f5"></i>#7aa0f5</span></div><p>一个艺人双臂高举的剪影：头是一个圆，手臂是一个 V。V 既是 VTuber 的 V，也是谢幕、安可时的姿势；两条手臂一深一浅，像聚光灯打在一侧。</p></div><div class="hb"><div class="st"><svg viewBox="0 0 48 48" width="200" height="200" aria-hidden="true" data-logo="einzbern" data-mode="color" data-size="200"><circle cx="24" cy="7.5" r="3.5" fill="#8aa6c9"/><path d="M10 14A14 14 0 0 0 38 14Z" fill="#3b5272"/><rect x="15" y="31" width="18" height="5" rx="2.5" fill="#8aa6c9"/><rect x="11" y="39" width="26" height="5" rx="2.5" fill="#3b5272"/></svg></div><h5>Einzbern<small>项目记忆引擎</small></h5><div class="chips"><span class="chip"><i style="background:#3b5272"></i>#3b5272</span><span class="chip"><i style="background:#8aa6c9"></i>#8aa6c9</span></div><p>一只盃接住一点光，盃下是两层基座：圣杯接住的是愿望，引擎接住的是项目的记忆；两层基座是存下来的层（纪要、卡片）。深浅交替，像一枚徽记。</p></div><div class="hb"><div class="st"><svg viewBox="0 0 48 48" width="200" height="200" aria-hidden="true" data-logo="mana" data-mode="color" data-size="200"><path d="M13 13C13 30 35 18 35 35" stroke="#9ddc8c" stroke-width="8" stroke-linecap="round" fill="none"/><circle cx="13" cy="13" r="7" fill="#3a9a63"/><circle cx="35" cy="35" r="7" fill="#3a9a63"/></svg></div><h5>Mana Orchestrate<small>项目记忆助手</small></h5><div class="chips"><span class="chip"><i style="background:#3a9a63"></i>#3a9a63</span><span class="chip"><i style="background:#9ddc8c"></i>#9ddc8c</span></div><p>两个结点，一道流：mana 从代理流到引擎，再流回来。结点是深绿，流是亮绿，像一条有生命的带子。</p></div><div class="hb"><div class="st"><svg viewBox="0 0 48 48" width="200" height="200" aria-hidden="true" data-logo="ds" data-mode="color" data-size="200"><rect x="4" y="4" width="17" height="40" rx="4" fill="#6577f3"/><rect x="24" y="4" width="20" height="17" rx="4" fill="#3096f4"/><rect x="24" y="24" width="9" height="20" rx="3" fill="#43d4cf"/><rect x="36" y="24" width="8" height="20" rx="3" fill="#78b957"/></svg></div><h5>TCRN Design System<small>设计系统</small></h5><div class="chips"><span class="chip"><i style="background:#6577f3"></i>#6577f3</span><span class="chip"><i style="background:#3096f4"></i>#3096f4</span><span class="chip"><i style="background:#43d4cf"></i>#43d4cf</span><span class="chip"><i style="background:#78b957"></i>#78b957</span></div><p>一张版面：四块大小不等的面，四种颜色。版面是布局，颜色是调色板，合起来就是设计系统；四种颜色沿用 TCRN 母标的紫蓝、蓝、青、绿。</p></div></div></div>
<div class="blk"><h6>B · 尺寸阶梯 <span>同一个形从 128 到 16，不换切法</span></h6><div class="paper"><div class="ladder"><span></span><span class="hd">128</span><span class="hd">64</span><span class="hd">48</span><span class="hd">32</span><span class="hd">24</span><span class="hd">16</span><b>TCRN TMS</b><span class="c"><svg viewBox="0 0 48 48" width="128" height="128" aria-hidden="true" data-logo="tms" data-mode="color" data-size="128"><path d="M11 23L24 39" stroke="#2c63c8" stroke-width="9" stroke-linecap="round" fill="none"/><path d="M37 23L24 39" stroke="#7aa0f5" stroke-width="9" stroke-linecap="round" fill="none"/><circle cx="24" cy="12.5" r="8" fill="#2c63c8"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="64" height="64" aria-hidden="true" data-logo="tms" data-mode="color" data-size="64"><path d="M11 23L24 39" stroke="#2c63c8" stroke-width="9" stroke-linecap="round" fill="none"/><path d="M37 23L24 39" stroke="#7aa0f5" stroke-width="9" stroke-linecap="round" fill="none"/><circle cx="24" cy="12.5" r="8" fill="#2c63c8"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" data-logo="tms" data-mode="color" data-size="48"><path d="M11 23L24 39" stroke="#2c63c8" stroke-width="9" stroke-linecap="round" fill="none"/><path d="M37 23L24 39" stroke="#7aa0f5" stroke-width="9" stroke-linecap="round" fill="none"/><circle cx="24" cy="12.5" r="8" fill="#2c63c8"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="32" height="32" aria-hidden="true" data-logo="tms" data-mode="color" data-size="32"><path d="M11 23L24 39" stroke="#2c63c8" stroke-width="9" stroke-linecap="round" fill="none"/><path d="M37 23L24 39" stroke="#7aa0f5" stroke-width="9" stroke-linecap="round" fill="none"/><circle cx="24" cy="12.5" r="8" fill="#2c63c8"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true" data-logo="tms" data-mode="color" data-size="24"><path d="M11 23L24 39" stroke="#2c63c8" stroke-width="9" s