idth="18" height="5" rx="2.5" fill="#8aa6c9"/><rect x="11" y="39" width="26" height="5" rx="2.5" fill="#3b5272"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true" data-logo="einzbern" data-mode="color" data-size="24"><circle cx="24" cy="7.5" r="3.5" fill="#8aa6c9"/><path d="M10 14A14 14 0 0 0 38 14Z" fill="#3b5272"/><rect x="15" y="31" width="18" height="5" rx="2.5" fill="#8aa6c9"/><rect x="11" y="39" width="26" height="5" rx="2.5" fill="#3b5272"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="16" height="16" aria-hidden="true" data-logo="einzbern" data-mode="color" data-size="16"><circle cx="24" cy="7.5" r="3.5" fill="#8aa6c9"/><path d="M10 14A14 14 0 0 0 38 14Z" fill="#3b5272"/><rect x="15" y="31" width="18" height="5" rx="2.5" fill="#8aa6c9"/><rect x="11" y="39" width="26" height="5" rx="2.5" fill="#3b5272"/></svg></span><b>Mana Orchestrate</b><span class="c"><svg viewBox="0 0 48 48" width="128" height="128" aria-hidden="true" data-logo="mana" data-mode="color" data-size="128"><path d="M13 13C13 30 35 18 35 35" stroke="#9ddc8c" stroke-width="8" stroke-linecap="round" fill="none"/><circle cx="13" cy="13" r="7" fill="#3a9a63"/><circle cx="35" cy="35" r="7" fill="#3a9a63"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="64" height="64" aria-hidden="true" data-logo="mana" data-mode="color" data-size="64"><path d="M13 13C13 30 35 18 35 35" stroke="#9ddc8c" stroke-width="8" stroke-linecap="round" fill="none"/><circle cx="13" cy="13" r="7" fill="#3a9a63"/><circle cx="35" cy="35" r="7" fill="#3a9a63"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" data-logo="mana" data-mode="color" data-size="48"><path d="M13 13C13 30 35 18 35 35" stroke="#9ddc8c" stroke-width="8" stroke-linecap="round" fill="none"/><circle cx="13" cy="13" r="7" fill="#3a9a63"/><circle cx="35" cy="35" r="7" fill="#3a9a63"/></svg></span><span class="c"><svg viewBox="0 0 48 48" width="3