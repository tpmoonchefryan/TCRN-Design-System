{
  "description": "字体刻度：Heading 1–4、Text 的 size / tone / variant、numeral 与 caps、mono 编号、Highlight 的 mark、链接。family 与 tone 为 tokens.json 的 key（family 指 fixed 的 serif / sans / mono），size 与 line 单位 px。className 为包内类名，由 scripts/contract-generate.mjs 生成 typography.scale.ts。tokens 为字体刻度 token 的真值：key 为刻度名，cssVar 为包内变量名，value 为值；ref 指 tokens.json fixed 的 key，值取该 token 的值；生成器把它们写进 gplus-tokens.generated.ts，@tcrn/ui-tokens 从那里取值。各条目的 token 对象按声明（size / line / weight / tracking / numeric）点名 tokens 的 key：生成器核对 token 值与条目的数值相同（不同即报错），typography.scale.ts 的该声明写成 var(cssVar)；条目的数值仍供画板生成器读取。没有对应 token 的数值（numeral 的 inline 字号与 large 字号行高、mono 字号）照写字面值，新增刻度 token 待裁定。",
  "tokens": [
    { "key": "family-heading", "cssVar": "--tcrn-type-family-heading", "group": "type-family", "ref": "serif", "note": "标题字族，即 serif 字栈；标题不借 stamp 字族" },
    { "key": "size-ui", "cssVar": "--tcrn-type-size-ui", "group": "type-size", "value": "13px" },
    { "key": "size-reading", "cssVar": "--tcrn-type-size-reading", "group": "type-size", "value": "14px" },
    { "key": "size-caption", "cssVar": "--tcrn-type-size-caption", "group": "type-size", "value": "11px" },
    { "key": "size-meta", "cssVar": "--tcrn-type-size-meta", "group": "type-size", "value": "12px" },
    { "key": "size-body", "cssVar": "--tcrn-type-size-body", "group": "type-size", "value": "13px" },
    { "key": "size-section", "cssVar": "--tcrn-type-size-section", "group": "type-size", "value": "20px" },
    { "key": "size-page", "cssVar": "--tcrn-type-size-page", "group": "type-size", "value": "36px" },
    { "key": "size-heading-2", "cssVar": "--tcrn-type-size-heading-2", "group": "type-size", "value": "26px" },
    { "key": "size-heading-3", "cssVar": "--tcrn-type-size-heading-3", "group": "type-size", "value": "20px" },
    { "key": "size-stamp-min", "cssVar": "--tcrn-type-size-stamp-min", "group": "type-size", "value": "12px", "note": "stamp 字号下限" },
    { "key": "line-ui", "cssVar": "--tcrn-type-line-ui", "group": "type-line", "value": "20px" },
    { "key": "line-reading", "cssVar": "--tcrn-type-line-reading", "group": "type-line", "value": "22px" },
    { "key": "line-caption", "cssVar": "--tcrn-type-line-caption", "group": "type-line", "value": "16px" },
    { "key": "line-meta", "cssVar": "--tcrn-type-line-meta", "group": "type-line", "value": "16px" },
    { "key": "line-body", "cssVar": "--tcrn-type-line-body", "group": "type-line", "value": "20px" },
    { "key": "line-control", "cssVar": "--tcrn-type-line-control", "group": "type-line", "value": "1.2", "note": "控件文字行高，无单位" },
    { "key": "line-section", "cssVar": "--tcrn-type-line-section", "group": "type-line", "value": "26px" },
    { "key": "line-page", "cssVar": "--tcrn-type-line-page", "group": "type-line", "value": "40px" },
    { "key": "line-heading-2", "cssVar": "--tcrn-type-line-heading-2", "group": "type-line", "value": "30px" },
    { "key": "line-heading-3", "cssVar": "--tcrn-type-line-heading-3", "group": "type-line", "value": "26px" },
    { "key": "weight-light", "cssVar": "--tcrn-type-weight-light", "group": "type-weight", "value": "300" },
    { "key": "weight-regular", "cssVar": "--tcrn-type-weight-regular", "group": "type-weight", "value": "400" },
    { "key": "weight-medium", "cssVar": "--tcrn-type-weight-medium", "group": "type-weight", "value": "500" },
    { "key": "weight-semibold", "cssVar": "--tcrn-type-weight-semibold", "group": "type-weight", "value": "600" },
    { "key": "weight-strong", "cssVar": "--tcrn-type-weight-strong", "group": "type-weight", "value": "600", "note": "G+ 没有 700" },
    { "key": "tracking-caps", "cssVar": "--tcrn-type-tracking-caps", "group": "type-tracking", "value": ".14em" },
    { "key": "tracking-stamp", "cssVar": "--tcrn-type-tracking-stamp", "group": "type-tracking", "value": "0.06em", "note": "stamp 字距" },
    { "key": "numeric-tabular", "cssVar": "--tcrn-type-numeric-tabular", "group": "type-numeric", "value": "tabular-nums lining-nums" }
  ],
  "headings": [
    { "level": 1, "className": "tcrn-heading--1", "family": "serif", "size": 36, "line": 40, "weight": 400, "tracking": "-.01em", "tone": "ink", "truncate": true, "token": { "size": "size-page", "line": "line-page", "weight": "weight-regular" } },
    { "level": 2, "className": "tcrn-heading--2", "family": "serif", "size": 26, "line": 30, "weight": 400, "tracking": "-.005em", "tone": "ink", "truncate": true, "token": { "size": "size-heading-2", "line": "line-heading-2", "weight": "weight-regular" } },
    { "level": 3, "className": "tcrn-heading--3", "family": "serif", "size": 20, "line": 26, "weight": 400, "tracking": "0", "tone": "ink", "truncate": true, "token": { "size": "size-heading-3", "line": "line-heading-3", "weight": "weight-regular" } },
    { "level": 4, "className": "tcrn-heading--4", "family": "sans", "size": 13, "line": 20, "weight": 600, "tone": "ink", "truncate": true, "token": { "size": "size-ui", "line": "line-ui", "weight": "weight-semibold" } }
  ],
  "text": {
    "className": "tcrn-text",
    "base": { "size": 13, "line": 20, "tone": "ink-2", "token": { "size": "size-ui", "line": "line-ui" } },
    "sizes": [
      { "name": "body", "className": "tcrn-text--body", "size": 13, "line": 20, "token": { "size": "size-body", "line": "line-body" } },
      { "name": "reading", "className": "tcrn-text--reading", "size": 14, "line": 22, "token": { "size": "size-reading", "line": "line-reading" } },
      { "name": "meta", "className": "tcrn-text--meta", "size": 12, "line": 16, "tone": "ink-3", "token": { "size": "size-meta", "line": "line-meta" } },
      { "name": "caption", "className": "tcrn-text--caption", "size": 11, "line": 16, "tone": "ink-3", "token": { "size": "size-caption", "line": "line-caption" } }
    ],
    "tones": [
      { "name": "default", "tone": "ink-2" },
      { "name": "strong", "className": "tcrn-text--strong", "tone": "ink", "weight": 600, "token": { "weight": "weight-strong" } }
    ],
    "variants": [
      { "name": "numeral", "className": "tcrn-text--numeral" },
      { "name": "caps", "className": "tcrn-text--caps" }
    ]
  },
  "numeral": {
    "family": "serif",
    "size": 26,
    "line": 30,
    "weight": 300,
    "tracking": "-.01em",
    "tone": "ink",
    "numeric": "tabular-nums lining-nums",
    "gap": 5,
    "token": { "size": "size-heading-2", "line": "line-heading-2", "weight": "weight-light", "numeric": "numeric-tabular" },
    "unit": { "family": "sans", "size": 11, "line": 16, "weight": 500, "tracking": ".06em", "tone": "ink-3", "token": { "size": "size-caption", "line": "line-caption", "weight": "weight-medium" } },
    "inline": { "className": "tcrn-text--numeral-inline", "size": 16, "line": 20, "weight": 400, "tracking": "0", "token": { "line": "line-ui", "weight": "weight-regular" } },
    "large": { "className": "tcrn-text--numeral-large", "size": 44, "line": 48 }
  },
  "caps": {
    "family": "sans",
    "size": 11,
    "line": 16,
    "weight": 500,
    "tracking": ".14em",
    "tone": "ink-3",
    "transform": "uppercase",
    "token": { "size": "size-caption", "line": "line-caption", "weight": "weight-medium", "tracking": "tracking-caps" },
    "prefix": { "family": "mono", "weight": 500, "tracking": ".04em", "tone": "ink", "gap": 8, "token": { "weight": "weight-medium" } }
  },
  "mono": { "className": "tcrn-text--mono", "family": "mono", "size": 11.5, "line": 16, "tone": "ink-2", "token": { "line": "line-caption" } },
  "link": {
    "className": "tcrn-link",
    "tone": "acc",
    "underline": "acc-ul",
    "thickness": "1px",
    "offset": "2px",
    "radius": "2px",
    "hover": { "tone": "acc-2", "underline": "acc-2" },
    "focus": { "ring": "focus" },
    "pairs": {
      "note": "链接状态对表（写法同 pairs.json）：变体声明 --tcrn-pair-<slot>-<态>，基础规则读生效对，:where() 状态规则只切换生效对。tone、underline、hover、focus 四个字段供画板生成器读取，须与 default 变体一致（生成器核对）。quiet 是 .tcrn-link 的修饰类：默认随上下文文字色、无可见下划线，悬停为 acc-2。",
      "slots": ["ink", "underline", "edge"],
      "slotVars": { "ink": "--tcrn-pair-ink", "underline": "--tcrn-pair-underline", "edge": "--tcrn-pair-edge" },
      "targets": [
        { "base": ".tcrn-link", "variants": ["default"] },
        { "base": ".tcrn-link", "modifier": "tcrn-link--{variant}", "variants": ["quiet"] }
      ],
      "states": [
        { "key": "d", "name": "default" },
        { "key": "h", "name": "hover", "when": [":hover", "[data-tcrn-preview-state=\"hover\"]"] },
        { "key": "f", "name": "focus", "when": [":focus-visible", "[data-tcrn-preview-state=\"focus\"]"], "switch": ["edge"] }
      ],
      "ruleOrder": ["h", "f"],
      "variants": {
        "default": {
          "d": { "ink": "acc", "underline": "acc-ul", "edge": "0 0 #0000" },
          "h": { "ink": "acc-2", "underline": "acc-2" },
          "f": { "edge": "var(--focus)" }
        },
        "quiet": {
          "d": { "ink": "currentColor", "underline": "transparent" },
          "h": { "ink": "acc-2", "underline": "acc-2" }
        }
      }
    }
  },
  "mark": { "className": "tcrn-highlight__mark", "fill": "acc-bg", "radius": "2px", "spread": "2px" }
}
