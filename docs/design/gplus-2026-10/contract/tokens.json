{
  "description": "G+ token 真值。themed 为主题相关 token（浅色与夜间键集相同，C5），fixed 为主题无关 token，brand 为产品后缀色（aos 保持现状，不在此列）。key 即画板变量名去掉前导 --；cssVar 为包内变量名。",
  "themes": {
    "light": { "selector": ":root", "board": ".gp" },
    "night": { "selector": "[data-tcrn-theme=\"dark\"]", "board": ".gp.night" }
  },
  "themed": [
