{
  "description": "G+ token 真值。themed 为主题相关 token（浅色与夜间键集相同，C5），fixed 为主题无关 token，brand 为产品后缀色（aos 保持现状，不在此列；默认主题无关，带 night 与 nightRef 的条目按主题输出）。key 即画板变量名去掉前导 --；cssVar 为包内变量名。",
  "themes": {
    "light": { "selector": ":root", "board": ".gp" },
    "night": { "selector": "[data-tcrn-theme=\"dark\"]", "board": ".gp.night" }
  },
  "themed": [
    { "key": "bg", "cssVar": "--tcrn-color-bg", "group": "color", "light": "#efeeea", "night": "#121210" },
    { "key": "bg-2", "cssVar": "--tcrn-color-bg-2", "group": "color", "light": "#e7e5df", "night": "#0d0d0b" },
    { "key": "panel", "cssVar": "--tcrn-color-panel", "group": "color", "light": "#ffffff", "night": "#191916" },
    { "key": "panel-2", "cssVar": "--tcrn-color-panel-2", "group": "color", "light": "#f8f7f3", "night": "#1f1f1b" },
    { "key": "line", "cssVar": "--tcrn-color-line", "group": "color", "light": "rgba(22,21,15,.09)", "night": "rgba(255,255,255,.07)" },
    { "key": "line-2", "cssVar": "--tcrn-color-line-2", "group": "color", "light": "rgba(22,21,15,.16)", "night": "rgba(255,255,255,.13)" },
    { "key": "line-3", "cssVar": "--tcrn-color-line-3", "group": "color", "light": "rgba(22,21,15,.30)", "night": "rgba(255,255,255,.26)" },
    { "key": "line-ctl", "cssVar": "--tcrn-color-line-ctl", "group": "color", "light": "rgba(22,21,15,.47)", "night": "rgba(255,255,255,.36)" },
    { "key": "rule", "cssVar": "--tcrn-color-rule", "group": "color", "light": "#16150f", "night": "#ebe8df" },
    { "key": "ink", "cssVar": "--tcrn-color-ink", "group": "color", "light": "#16150f", "night": "#ebe8df" },
    { "key": "ink-2", "cssVar": "--tcrn-color-ink-2", "group": "color", "light": "#4f4c43", "night": "#a9a69c" },
    { "key": "ink-3", "cssVar": "--tcrn-color-ink-3", "group": "color", "light": "#6b675d", "night": "#85827a" },
    { "key": "acc", "cssVar": "--tcrn-color-acc", "group": "color", "light": "#0b6b65", "night": "#3fc7b7" },
    { "key": "acc-2", "cssVar": "--tcrn-color-acc-2", "group": "color", "light": "#0a5f5a", "night": "#5ad3c5" },
    { "key": "acc-3", "cssVar": "--tcrn-color-acc-3", "group": "color", "light": "#084f4a", "night": "#34b3a4" },
    { "key": "acc-bg", "cssVar": "--tcrn-color-acc-bg", "group": "color", "light": "rgba(11,107,101,.08)", "night": "rgba(63,199,183,.10)" },
    { "key": "acc-ul", "cssVar": "--tcrn-color-acc-ul", "group": "color", "light": "rgba(11,107,101,.7)", "night": "rgba(63,199,183,.7)" },
    { "key": "on-acc", "cssVar": "--tcrn-color-on-acc", "group": "color", "light": "#ffffff", "night": "#07211e" },
    { "key": "red", "cssVar": "--tcrn-color-red", "group": "color", "light": "#8e2d24", "night": "#d98d82" },
    { "key": "red-bg", "cssVar": "--tcrn-color-red-bg", "group": "color", "light": "rgba(142,45,36,.06)", "night": "rgba(217,141,130,.08)" },
    { "key": "red-bg-2", "cssVar": "--tcrn-color-red-bg-2", "group": "color", "light": "rgba(142,45,36,.11)", "night": "rgba(217,141,130,.14)" },
    { "key": "ok", "cssVar": "--tcrn-color-ok", "group": "color", "light": "#2f6b3a", "night": "#6fcf97" },
    { "key": "warn", "cssVar": "--tcrn-color-warn", "group": "color", "light": "#8a5a08", "night": "#d9ab52" },
    { "key": "bad", "cssVar": "--tcrn-color-bad", "group": "color", "light": "#a8321f", "night": "#e5897b" },
    { "key": "bad-bg", "cssVar": "--tcrn-color-bad-bg", "group": "color", "light": "rgba(168,50,31,.08)", "night": "rgba(229,137,123,.10)" },
    { "key": "wash", "cssVar": "--tcrn-color-wash", "group": "color", "light": "rgba(22,21,15,.06)", "night": "rgba(235,232,223,.07)" },
    { "key": "hover", "cssVar": "--tcrn-color-hover", "group": "color", "light": "rgba(22,21,15,.035)", "night": "rgba(235,232,223,.04)" },
    { "key": "dis", "cssVar": "--tcrn-color-dis", "group": "color", "light": "rgba(22,21,15,.05)", "night": "rgba(235,232,223,.05)" },
    { "key": "s1", "cssVar": "--tcrn-shadow-s1", "group": "shadow", "light": "0 1px 1px rgba(22,21,15,.04),0 0 0 1px rgba(22,21,15,.07)", "night": "0 1px 1px rgba(0,0,0,.3),0 0 0 1px rgba(255,255,255,.06)" },
    { "key": "s2", "cssVar": "--tcrn-shadow-s2", "group": "shadow", "light": "0 1px 2px rgba(22,21,15,.05),0 2px 3px rgba(22,21,15,.04),0 0 0 1px rgba(22,21,15,.08)", "night": "0 1px 2px rgba(0,0,0,.35),0 2px 3px rgba(0,0,0,.3),0 0 0 1px rgba(255,255,255,.07)" },
    { "key": "s3", "cssVar": "--tcrn-shadow-s3", "group": "shadow", "light": "0 2px 3px rgba(22,21,15,.06),0 3px 3px rgba(22,21,15,.06),0 0 0 1px rgba(22,21,15,.10)", "night": "0 2px 3px rgba(0,0,0,.4),0 3px 3px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.09)" },
    { "key": "glass", "cssVar": "--tcrn-color-glass", "group": "color", "light": "rgba(255,255,255,.78)", "night": "rgba(25,25,22,.74)" },
    { "key": "edge", "cssVar": "--tcrn-shadow-edge", "group": "shadow", "light": "inset 0 0 0 1px rgba(255,255,255,.8)", "night": "inset 0 1px 0 rgba(255,255,255,.06)" },
    { "key": "grain", "cssVar": "--tcrn-grain-opacity", "group": "texture", "light": ".035", "night": ".06" },
    { "key": "blend", "cssVar": "--tcrn-grain-blend", "group": "texture", "light": "multiply", "night": "screen" },
    { "key": "av-bg", "cssVar": "--tcrn-color-av-bg", "group": "color", "light": "#e7e5df", "night": "#2a2a26" },
    { "key": "av-ink", "cssVar": "--tcrn-color-av-ink", "group": "color", "light": "#16150f", "night": "#ebe8df" },
    { "key": "knob", "cssVar": "--tcrn-color-knob", "group": "color", "light": "#ffffff", "night": "#ffffff" },
    { "key": "chrome", "cssVar": "--tcrn-color-chrome", "group": "color", "light": "rgba(239,238,234,.82)", "night": "rgba(18,18,16,.82)" }
  ],
  "fixed": [
    { "key": "surface", "cssVar": "--tcrn-color-surface", "group": "color", "value": "var(--bg)", "note": "焦点环间隙色，取 bg：包与画板的焦点环间隙都显示 bg 色，不随承载面（如纸上的 panel）切换" },
    { "key": "focus", "cssVar": "--tcrn-focus-ring", "group": "focus", "value": "0 0 0 2px var(--surface),0 0 0 4px var(--acc)", "note": "2px 承载面色间隙 + 2px acc" },
    { "key": "serif", "cssVar": "--tcrn-type-family-serif", "group": "type-family", "value": "\"Source Serif 4\",\"Noto Serif SC\",Georgia,serif", "note": "新增" },
    { "key": "sans", "cssVar": "--tcrn-type-family-ui", "group": "type-family", "value": "\"Hanken Grotesk\",\"Noto Sans SC\",system-ui,sans-serif", "note": "沿用现有变量名，换字体" },
    { "key": "mono", "cssVar": "--tcrn-type-family-mono", "group": "type-family", "value": "\"IBM Plex Mono\",\"Noto Sans SC\",ui-monospace,Menlo,monospace", "note": "沿用现有变量名，换字体" },
    { "key": "r-ctl", "cssVar": "--tcrn-radius-control", "group": "radius", "value": "8px" },
    { "key": "r-sm", "cssVar": "--tcrn-radius-small", "group": "radius", "value": "6px" },
    { "key": "r-panel", "cssVar": "--tcrn-radius-panel", "group": "radius", "value": "12px" },
    { "key": "r-check", "cssVar": "--tcrn-radius-check", "group": "radius", "value": "4px" },
    { "key": "r-stamp", "cssVar": "--tcrn-radius-stamp", "group": "radius", "value": "3px" },
    { "key": "r-paper", "cssVar": "--tcrn-radius-paper", "group": "radius", "value": "14px", "note": "顶带壳纸面圆角（ProductShell 顶带下的纸面）；板 --paper-r" },
    { "key": "h-sm", "cssVar": "--tcrn-control-height-sm", "group": "control-height", "value": "28px" },
    { "key": "h-md", "cssVar": "--tcrn-control-height-md", "group": "control-height", "value": "32px" },
    { "key": "h-lg", "cssVar": "--tcrn-control-height-lg", "group": "control-height", "value": "40px" },
    { "key": "pad-sm", "cssVar": "--tcrn-control-padding-sm", "group": "control-padding", "value": "10px" },
    { "key": "pad-md", "cssVar": "--tcrn-control-padding-md", "group": "control-padding", "value": "12px" },
    { "key": "pad-lg", "cssVar": "--tcrn-control-padding-lg", "group": "control-padding", "value": "16px" },
    { "key": "fs-sm", "cssVar": "--tcrn-type-size-control-sm", "group": "type-size", "value": "12px" },
    { "key": "fs-md", "cssVar": "--tcrn-type-size-control", "group": "type-size", "value": "13px", "note": "沿用现有变量名" },
    { "key": "fs-lg", "cssVar": "--tcrn-type-size-control-lg", "group": "type-size", "value": "14px" },
    { "key": "ico-sm", "cssVar": "--tcrn-icon-size-sm", "group": "icon-size", "value": "14px" },
    { "key": "ico-md", "cssVar": "--tcrn-icon-size-md", "group": "icon-size", "value": "16px" },
    { "key": "ico-lg", "cssVar": "--tcrn-icon-size-lg", "group": "icon-size", "value": "20px" },
    { "key": "ease", "cssVar": "--tcrn-motion-ease", "group": "motion", "value": "cubic-bezier(.22,1,.36,1)" },
    { "key": "t-fill", "cssVar": "--tcrn-motion-duration-fill", "group": "motion", "value": "120ms" },
    { "key": "t-press", "cssVar": "--tcrn-motion-duration-press", "group": "motion", "value": "80ms" },
    { "key": "t-move", "cssVar": "--tcrn-motion-duration-move", "group": "motion", "value": "240ms" },
    { "key": "t-loop", "cssVar": "--tcrn-motion-duration-loop", "group": "motion", "value": "900ms" },
    { "key": "intro-fade", "cssVar": "--tcrn-motion-intro-fade", "group": "motion", "value": "120ms", "note": "07b F 段 motion.intro 第一段：登入卡淡出，等于 t-fill" },
    { "key": "intro-move", "cssVar": "--tcrn-motion-intro-move", "group": "motion", "value": "240ms", "note": "07b F 段 motion.intro 第二段：标 128 → 22 飞向顶带，等于 t-move" },
    { "key": "intro-rise", "cssVar": "--tcrn-motion-intro-rise", "group": "motion", "value": "100ms", "note": "07b F 段 motion.intro 第三段：纸升起、字标与固定项淡入" },
    { "key": "intro-max", "cssVar": "--tcrn-motion-intro-max", "group": "motion", "value": "700ms", "note": "07b F 段 motion.intro 总时长上限（三段合计 460）" },
    { "key": "rail-w", "cssVar": "--tcrn-shell-sidebar-width", "group": "shell", "value": "220px", "note": "退役（07b F 段，顶带壳没有常驻侧栏）：弃用、无继任、保留原值；原为构图一侧栏宽（O-1）" },
    { "key": "rail-w-collapsed", "cssVar": "--tcrn-shell-sidebar-width-collapsed", "group": "shell", "value": "52px", "note": "退役（07b F 段，顶带壳没有常驻侧栏与收起钮）：弃用、无继任、保留原值；原为收起态侧栏宽（O-1、O-5）" },
    { "key": "topbar-h", "cssVar": "--tcrn-shell-topbar-height", "group": "shell", "value": "var(--shell-strip-h)", "note": "退役（07b F 段，顶栏由顶带接管）：弃用别名，指向 shell-strip-h" },
    { "key": "shell-strip-h", "cssVar": "--tcrn-shell-strip-h", "group": "shell", "value": "52px", "note": "07b F 段 shell.strip-h：顶带高，整行中线 26；板 --strip-h" },
    { "key": "shell-brand-h", "cssVar": "--tcrn-shell-brand-h", "group": "shell", "value": "40px", "note": "07b F 段 shell.brand-h：标按钮高，顶带内 top = (strip-h − brand-h) / 2 = 6；板 --tab" },
    { "key": "shell-brand-w", "cssVar": "--tcrn-shell-brand-w", "group": "shell", "value": "134px", "note": "07b F 段 shell.brand-w：标按钮宽（第二版，侧栏尺度首行加示意）；第一版纯标时宽自适应" },
    { "key": "shell-toggle", "cssVar": "--tcrn-shell-toggle", "group": "shell", "value": "20px", "note": "07b F 段 shell.toggle：展开示意格，chevron 16" },
    { "key": "shell-pin-h", "cssVar": "--tcrn-shell-pin-h", "group": "shell", "value": "32px", "note": "07b F 段 shell.pin-h：顶带固定项高" },
    { "key": "shell-pin-gap", "cssVar": "--tcrn-shell-pin-gap", "group": "shell", "value": "8px", "note": "07b F 段 shell.pin-gap：标按钮到固定项、固定项之间三处相等，无分割线；板 --pin-gap" },
    { "key": "shell-pins-max", "cssVar": "--tcrn-shell-pins-max", "group": "shell", "value": "6", "note": "07b F 段 shell.pins-max：顶带固定项上限（个数，无单位）" },
    { "key": "shell-menu-gap", "cssVar": "--tcrn-shell-menu-gap", "group": "shell", "value": "6px", "note": "07b F 段 shell.menu-gap：完整菜单与下拉的顶到键底的接续；板 --menu-gap" },
    { "key": "shell-panel-w-expanded", "cssVar": "--tcrn-shell-panel-w-expanded", "group": "shell", "value": "952px", "note": "07b F 段 shell.panel-w-expanded：完整菜单宽；板 --panel-wx" },
    { "key": "shell-pbar-h", "cssVar": "--tcrn-shell-pbar-h", "group": "shell", "value": "44px", "note": "07b F 段 shell.pbar-h：完整菜单底栏，加面板底内距 8 = 底栏带 52" },
    { "key": "shell-drop-w", "cssVar": "--tcrn-shell-drop-w", "group": "shell", "value": "240px", "note": "07b F 段 shell.drop-w：下拉与级联列宽；板 --drop-w" },
    { "key": "shell-drop-srch-h", "cssVar": "--tcrn-shell-drop-srch-h", "group": "shell", "value": "28px", "note": "07b F 段 shell.drop-srch-h：下拉内搜索高（SearchInput sm）" },
    { "key": "shell-cascade-gap", "cssVar": "--tcrn-shell-cascade-gap", "group": "shell", "value": "4px", "note": "07b F 段 shell.cascade-gap：级联列间；板 --cascade-gap" },
    { "key": "shell-row-h", "cssVar": "--tcrn-shell-row-h", "group": "shell", "value": "32px", "note": "07b F 段 shell.row-h：菜单项高；触摸端 44 由 pointer: coarse 切换，不另设 token；板 --row-h" },
    { "key": "shell-srch-h", "cssVar": "--tcrn-shell-srch-h", "group": "shell", "value": "40px", "note": "07b F 段 shell.srch-h：完整菜单搜索高；触摸端 44 由 pointer: coarse 切换，不另设 token；板 --srch-h" },
    { "key": "shell-pinb", "cssVar": "--tcrn-shell-pinb", "group": "shell", "value": "24px", "note": "07b F 段 shell.pinb：图钉位与图钉钮；板 --pinb" }
  ],
  "brand": [
    { "key": "brand-suffix-tms", "cssVar": "--tcrn-brand-suffix-tms", "group": "brand", "value": "#2c63c8", "ref": "marks.json#tms.palette.deep", "night": "#7aa0f5", "nightRef": "marks.json#tms.palette.bright", "note": "夜间值取 mark 的 bright 色（O-3）：带 night 的 brand 条目按主题写进浅色块与夜间块" },
    { "key": "brand-suffix-einzbern", "cssVar": "--tcrn-brand-suffix-einzbern", "group": "brand", "value": "#3b5272", "ref": "marks.json#einzbern.palette.deep" },
    { "key": "brand-suffix-mana-orchestrate", "cssVar": "--tcrn-brand-suffix-mana-orchestrate", "group": "brand", "value": "#3a9a63", "ref": "marks.json#mana.palette.deep" },
    { "key": "brand-suffix-design-system", "cssVar": "--tcrn-brand-suffix-design-system", "group": "brand", "value": "#6577f3", "ref": "marks.json#ds.palette.deep" }
  ]
}
