    { "id": "overlay", "name": "Overlay", "batch": 3, "components": ["Dialog", "ConfirmActionDialog", "ActionDrawer", "DetailDrawer", "Menu", "Popover", "Tooltip", "Sheet"], "blocks": ["tcrn-dialog", "tcrn-confirm-dialog", "tcrn-action-drawer", "tcrn-detail-drawer", "tcrn-menu", "tcrn-popover", "tcrn-tooltip", "tcrn-sheet"] },
    { "id": "display", "name": "Display", "batch": 4, "components": ["Avatar", "Card", "KeyValueList", "DefinitionList", "LabelSet", "MachineToken", "MachineTokenCell", "RelationshipChip", "StatCard", "DictionaryTable"], "blocks": ["tcrn-avatar", "tcrn-card", "tcrn-key-value-list", "tcrn-definition-list", "tcrn-label-set", "tcrn-machine-token", "tcrn-machine-token-cell", "tcrn-relationship-chip", "tcrn-stat-card", "tcrn-dictionary-table"] },
    { "id": "records", "name": "Records", "batch": 4, "components": ["DataGrid", "TableShell", "TableToolbar", "RowGroup", "RecordRow", "RecordTable", "FilterBar", "QuickFilters", "SavedViewToolbar", "SearchableList", "SearchResultList", "AttachmentList", "InlineCreate"], "blocks": ["tcrn-data-grid", "tcrn-table-shell", "tcrn-table-toolbar", "tcrn-row-group", "tcrn-record-row", "tcrn-record-table", "tcrn-filter-bar", "tcrn-quick-filters", "tcrn-saved-view-toolbar", "tcrn-searchable-list", "tcrn-search-result-list", "tcrn-attachment-list", "tcrn-inline-create"] },
    { "id": "boards", "name": "Boards and flows", "batch": 5, "components": ["LaneBoard", "StagePipeline", "Stepper", "ActivityFeed", "VersionHistory", "RelationGraph", "Tree"], "blocks": ["tcrn-lane-board", "tcrn-stage-pipeline", "tcrn-stepper", "tcrn-activity-feed", "tcrn-version-history", "tcrn-relation-graph", "tcrn-tree"] },
    { "id": "inspection", "name": "Inspection and documents", "batch": 5, "components": ["DetailInspector", "RecordInspector", "MetadataRail", "DocumentCanvas", "InlineCommentList", "TemplateGallery", "ContentScope"], "blocks": ["tcrn-detail-inspector", "tcrn-record-inspector", "tcrn-metadata-rail", "tcrn-document-canvas", "tcrn-inline-comment-list", "tcrn-template-gallery", "tcrn-content-scope"] }
  ]
}
