{
  "schemaVersion": "tcrn.ds.contract-families.v1",
  "description": "组件家族与包 CSS 根类（BEM block）的对应。家族、批次与组件名出自画板 docs/design/gplus-2026-10/boards/V2-Families.dc.html；blocks 是 tcrnComponentCss 里属于该家族的根类（类名去掉 __ 与 -- 之后的部分）。契约静态门（scripts/contract-static-proof.mjs）据此把规则归到家族：scope.batch 指定的批次全量检查，其它家族只有 exemptions.json 里有登记时才豁免，不属于任何家族的类一律检查。",
  "scope": {
    "batch": 1,
    "note": "第一批五家族（字体、图标、品牌、动作、表单控件）是 TCRN-DS-INIT-015 授权进包的范围；后续批次的家族按 exemptions.json 逐条登记。"
  },
  "utilities": ["tcrn-sr-only"],
  "families": [
    { "id": "typography", "name": "Typography", "batch": 1, "components": ["Heading", "Text", "Highlight"], "blocks": ["tcrn-heading", "tcrn-text", "tcrn-highlight", "tcrn-highlight-text", "tcrn-link"] },
    { "id": "icon", "name": "Icon", "batch": 1, "components": ["Icon"], "blocks": ["tcrn-icon"] },
    { "id": "brand", "name": "Brand", "batch": 1, "components": ["TcrnBrandMark", "ProductLogo", "ProductLockup"], "blocks": ["tcrn-brand-mark", "tcrn-product-logo", "tcrn-brand-lockup", "tcrn-brand-wordmark"] },
    { "id": "actions", "name": "Actions", "batch": 1, "components": ["Button", "IconButton", "LinkButton", "ClipboardCopyButton", "ButtonGroup"], "blocks": ["tcrn-button", "tcrn-icon-button", "tcrn-link-button", "tcrn-clipboard-copy-button", "tcrn-button-group"] },
    { "id": "inputs", "name": "Inputs", "batch": 1, "components": ["Input", "Textarea", "SearchInput", "SuggestInput", "Select", "MultiSelect", "NumberInput", "DatePicker", "Checkbox", "RadioGroup", "Switch"], "blocks": ["tcrn-input", "tcrn-textarea", "tcrn-search-input", "tcrn-suggest-input", "tcrn-select", "tcrn-multi-select", "tcrn-multi-select-dropdown", "tcrn-multi-select-group", "tcrn-number-input", "tcrn-number-input-field", "tcrn-date-picker", "tcrn-checkbox", "tcrn-radio-group", "tcrn-switch"] },
    { "id": "settings", "name": "Settings", "batch": 5, "components": ["Field", "FieldProvenance", "LockHint", "LineNumberedEditor", "SettingChoice", "SettingRow", "SettingRowList", "SettingsHostSwitcher"], "blocks": ["tcrn-field", "tcrn-field-provenance", "tcrn-lock-hint", "tcrn-line-numbered-editor", "tcrn-setting-choice", "tcrn-setting-row", "tcrn-setting-row-list", "tcrn-settings-host-switcher"] },
    { "id": "navigation", "name": "Navigation", "batch": 2, "components": ["Breadcrumb", "Tabs", "SubNav", "SegmentedNav", "Pagination", "NavGroup", "NavItem", "SideNav", "SideNavCollapseButton", "MobileNavToggle", "SkipLink", "TocRail", "TreeNav"], "blocks": ["tcrn-breadcrumb", "tcrn-tabs", "tcrn-section-tabs", "tcrn-module-tabs", "tcrn-view-tabs", "tcrn-sub-nav", "tcrn-segmented-nav", "tcrn-pagination", "tcrn-nav-group", "tcrn-nav-item", "tcrn-side-nav", "tcrn-shell-side-nav-toggle", "tcrn-shell-mobile-nav-toggle", "tcrn-skip-link", "tcrn-toc-rail", "tcrn-tree-nav"] },
    { "id": "shell", "name": "Shell", "batch": 2, "components": ["ProductShell", "TopBar", "ProductShellSearch", "ShellThemeToggle", "ShellLocaleMenu", "ShellBrandLockup", "ShellBrandButton", "ShellPins", "ShellMenu", "ShellDropdown", "ShellIntro", "ProductLauncher", "ProductSwitcher", "AppStatusBar"], "blocks": ["tcrn-product-shell", "tcrn-product-shell-content-stack", "tcrn-product-shell-section-grid", "tcrn-top-bar", "tcrn-product-shell-search", "tcrn-shell-theme-toggle", "tcrn-shell-locale-menu", "tcrn-shell-brand-lockup", "tcrn-shell-brand", "tcrn-shell-pins", "tcrn-shell-menu", "tcrn-shell-dropdown", "tcrn-shell-intro", "tcrn-product-launcher", "tcrn-product-switcher", "tcrn-app-status-bar"] },
